DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multi_rate
# Hosted Postgres (Neon, etc.): include host only — SSL is enabled in app code.
# Example: postgresql://user:pass@ep-xxx.neon.tech/neondb
# Avoid relying on sslmode=require in the URL (pg warns about upcoming semantics).
# DATABASE_SSL=true
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
NODE_ENV=development

# Email — prefer Brevo HTTPS API on Render (outbound SMTP is often blocked)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM="Multi-Rate <verified-sender@yourdomain.com>"

# Optional SMTP fallback (local only; usually fails on Render)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login@smtp-brevo.com
# SMTP_PASSWORD=xsmtpsib-your-smtp-key

# Optional: fixed OTP + skip send (local/e2e only — never in production)
# OTP_FIXED_CODE=123456
# OTP_SKIP_SEND=true

# Temporary: email+password signup/login without OTP
# Set to false when Brevo email delivery works
SKIP_EMAIL_VERIFICATION=true
