DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multi_rate
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
NODE_ENV=development

# Brevo SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-your-smtp-key
EMAIL_FROM="Multi-Rate <verified-sender@yourdomain.com>"

# Optional: fixed OTP + skip send (local/e2e only — never in production)
# OTP_FIXED_CODE=123456
# OTP_SKIP_SEND=true

# Temporary while Brevo SMTP is blocked: email+password login/signup without OTP
# Set to false when SMTP works again
SKIP_EMAIL_VERIFICATION=true
